{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Play note block songs in Minecraft",
  "authors": [
    "SemmieDev"
  ],
  "contributors": [
    "EnderKill98",
    "myueqf",
    "EnderPhantomWing",
    "Fhxa3",
    "HGD7764"
  ],
  "contact": {
    "repo": "${mod_homepage}"
  },
  "license": "MIT",
  "icon": "assets/disc_jockey/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "semmiedev.disc_jockey.DiscJockey"
    ],
    "modmenu": [
      "semmiedev.disc_jockey.compat.modmenu.ModMenuIntegration"
    ]
  },
  "accessWidener": "disc_jockey.accesswidener",
  "mixins": [
    "disc_jockey.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "cloth-config": ">=${cloth_config_api_version}"
  }
}
